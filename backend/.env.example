# SEC rejects requests without a descriptive User-Agent: "<team> <email>"
SEC_USER_AGENT="StartupSignals your-email@example.com"

# Mapbox Geocoding (server-side token; batch geocoding with permanent=true)
MAPBOX_TOKEN=
MAPBOX_PERMANENT_GEOCODING_CONFIRMED=false

# Adzuna job search (free key, issued instantly)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USPTO Open Data Portal (X-API-Key header; needs ID.me verification)
USPTO_API_KEY=
# Existing Supabase project. Keep the secret key server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional connection string for applying migrations.
SUPABASE_DB_URL=
# Set true only to serve the labeled local sample file for an offline demo.
DEMO_SAMPLE_MODE=false
# Optional comma-separated source names for a targeted pipeline run.
PIPELINE_SOURCES=
