# SEC rejects requests without a descriptive User-Agent: "<team> <email>"
SEC_USER_AGENT="StartupSignals your-email@example.com"

# Mapbox Geocoding (server-side token; batch geocoding with permanent=true)
MAPBOX_TOKEN=

# Adzuna job search (free key, issued instantly)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USPTO Open Data Portal (X-API-Key header; needs ID.me verification)
USPTO_API_KEY=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only)
OPENAI_API_KEY=